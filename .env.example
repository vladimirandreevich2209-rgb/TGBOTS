# GEMINI_API_KEY: Required for server-side Gemini AI features.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted (e.g., https://shortsmaster.pages.dev)
APP_URL=https://shortsmaster.pages.dev

# --- GOOGLE / YOUTUBE OAUTH CONFIGURATION ---
# Google Cloud Console OAuth 2.0 Client credentials with YouTube Data API v3 enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# --- TIKTOK API CONFIGURATION ---
# TikTok for Developers App Client Key and Secret with Content Posting API v2 permissions
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- TELEGRAM BOT CONFIGURATION ---
# Telegram Bot Token from @BotFather (optional for validating Telegram initData)
TELEGRAM_BOT_TOKEN=
